DJANGO_DEBUG=false
DJANGO_SECRET_KEY={{ mycamino_django_secret_key }}
DJANGO_ALLOWED_HOSTS={{ mycamino_host }},127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://{{ mycamino_host }}
DJANGO_DATABASE_PATH=/data/db.sqlite3
PUBLIC_BASE_URL=https://{{ mycamino_host }}
MYCAMINO_DOCS_ROOT=/app/docs
MYCAMINO_LEGAL_CONFIG_REQUIRED=true
MYCAMINO_OPERATOR_NAME={{ mycamino_operator_name }}
MYCAMINO_OPERATOR_ADDRESS={{ mycamino_operator_address }}
MYCAMINO_OPERATOR_EMAIL={{ mycamino_operator_email }}
FORM_IP_SALT={{ mycamino_form_ip_salt }}
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST={{ mycamino_smtp_host }}
EMAIL_PORT={{ mycamino_smtp_port }}
EMAIL_HOST_USER={{ mycamino_smtp_username }}
EMAIL_HOST_PASSWORD={{ mycamino_smtp_password }}
EMAIL_USE_TLS={{ mycamino_smtp_use_tls | lower }}
EMAIL_USE_SSL={{ mycamino_smtp_use_ssl | lower }}
DEFAULT_FROM_EMAIL=myCamino <{{ mycamino_operator_email }}>
CONTACT_RECIPIENT={{ mycamino_operator_email }}
